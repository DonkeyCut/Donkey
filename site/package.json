{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://donkeycut.com",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "patch-package && node scripts/check-mediabunny-patch.mjs && prisma generate && node scripts/copy-mediapipe-assets.mjs && node scripts/fetch-cut-fonts.mjs",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "prisma:dev": "dotenv -e .env.development -- npx prisma migrate dev",
    "prisma:prod": "dotenv -e .env -- prisma db push",
    "engine:dev": "bun run src/cut/engine/main.ts",
    "engine:build": "bash scripts/build-cut-engine.sh",
    "worker:build": "bun build --target=node --minify --external=pg-native --external=skia-canvas --external=mediabunny --external=@mediabunny/server --external=node-web-audio-api --loader .css:text src/cut/worker/main.ts --outfile dist/cut-worker/main.js",
    "bench:watch": "bun run scripts/bench-watch.ts",
    "eval:cut-chat": "bun run scripts/eval-cut-chat.ts",
    "eval:cut-headless": "bun run scripts/eval-cut-headless.ts",
    "email:dev": "email dev --dir src/emails --port 3001",
    "test": "bun test src packages/effects-kit/src packages/abexp/src",
    "test:genvideo": "bun run scripts/genvideo-selftest.ts",
    "eval:genvideo": "bun run scripts/genvideo-eval.ts",
    "eval:cut-perf": "bun run scripts/eval-cut-perf.ts",
    "eval:cut-perf-lowend": "bun run scripts/eval-cut-perf.ts --bucket playback --runs 3 --machine ryzen-5500u",
    "eval:cut-sync": "bun run scripts/eval-cut-sync.ts",
    "eval:cut-edges": "bun run scripts/eval-cut-edges.ts",
    "eval:cut-keys": "bun run scripts/eval-cut-keys.ts",
    "eval:cut-export": "bun run scripts/eval-cut-export.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.15",
    "@anthropic-ai/claude-agent-sdk": "^0.3.201",
    "@aws-sdk/client-s3": "^3.1094.0",
    "@aws-sdk/s3-request-presigner": "^3.1094.0",
    "@base-ui/react": "^1.6.0",
    "@better-auth/core": "1.6.11",
    "@better-auth/kysely-adapter": "1.6.11",
    "@better-auth/utils": "0.4.0",
    "@donkeycut/abexp": "*",
    "@donkeycut/effects-kit": "*",
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@elevenlabs/elevenlabs-js": "^2.49.1",
    "@google/genai": "2.21.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mediabunny/server": "^1.55.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@next/mdx": "^16.2.6",
    "@posthog/react": "^1.10.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.101.0",
    "@types/mdx": "^2.0.13",
    "ai": "^7.0.14",
    "better-auth": "1.6.11",
    "browser-use-sdk": "^3.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "defuddle": "^0.18.1",
    "hls.js": "^1.6.16",
    "linkedom": "^0.18.12",
    "lucide-react": "^1.23.0",
    "mediabunny": "^1.55.5",
    "next": "16.2.6",
    "node-web-audio-api": "^2.2.0",
    "openai": "^6.39.0",
    "pg": "^8.20.0",
    "posthog-js": "^1.407.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^6.9.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "resend": "^6.18.1",
    "shadcn": "^4.7.0",
    "skia-canvas": "^3.0.8",
    "stripe": "^22.2.0",
    "svix": "^1.99.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@react-email/ui": "^6.9.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun": "^1.3.14",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "patch-package": "^8.0.1",
    "playwright": "^1.62.1",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
