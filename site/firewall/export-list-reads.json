{
  "name": "Limit export listing bursts",
  "description": "Limit export list reads before authentication and database access.",
  "active": true,
  "conditionGroup": [
    {
      "conditions": [
        { "type": "path", "op": "re", "value": "^/api/cut-cloud/projects/[^/]+/exports/?$" },
        { "type": "method", "op": "eq", "value": "GET" }
      ]
    }
  ],
  "action": {
    "mitigate": {
      "action": "rate_limit",
      "rateLimit": {
        "algo": "fixed_window",
        "window": 10,
        "limit": 20,
        "keys": ["ip"],
        "action": "rate_limit"
      }
    }
  }
}
