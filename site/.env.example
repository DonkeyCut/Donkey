DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Vercel sends this as a bearer token on cron invocations; the cron routes
# (analytics run, cut-cloud gc) reject requests without it.
CRON_SECRET="replace-with-a-long-random-secret"
GOOGLE_CLIENT_ID="replace-with-google-web-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-web-client-secret"

# Required for macOS desktop computer-use through OpenAI.
OPENAI_API_KEY="replace-with-openai-api-key"

# Optional hosted inference providers.
ELEVENLABS_API_KEY="replace-with-elevenlabs-api-key"

# Cut's background-removal matte segmenter.
FAL_KEY="replace-with-fal-api-key"

# Required for Gemini / Google Cloud inference through Vertex AI. The adapter
# uses the global endpoint and derives the project from project_id.
GOOGLE_APPLICATION_CREDENTIALS_JSON='{"type":"service_account",...}'

# Dev-only: a Gemini Developer API key. When set, the Live client connects
# directly to the Developer API (using GEMINI_LIVE_MODEL; the client default is an
# audio-output-only model) instead of minting a Vertex token. Production uses the
# keyless Vertex path above.
GEMINI_API_KEY="replace-with-gemini-api-key"

# Stripe. The Pro subscription plus one-time credit top-ups run through
# STRIPE_SECRET_KEY and the /api/billing/webhook endpoint (signed by
# STRIPE_WEBHOOK_SECRET).
#   STRIPE_PRO_PRICE_ID — recurring price for the Donkey Pro app plan; the
#     included monthly inference allowance equals this price (a $20/mo plan
#     includes $20 of inference), read straight from the price's amount.
STRIPE_SECRET_KEY="replace-with-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="replace-with-stripe-webhook-signing-secret"
STRIPE_PRO_PRICE_ID="replace-with-stripe-pro-price-id"
STRIPE_PORTAL_CONFIGURATION_ID="replace-with-stripe-portal-configuration-id"

# Browser Use Cloud (agentic web automation via /api/browser/run). Backend-only
# secret; the Mac app never carries it. Key starts with "bu_".
BROWSER_USE_API_KEY="replace-with-browser-use-api-key"

# Resend (transactional email + contact sync). Unset in dev skips email work:
# signups log the skip and provision everything else. The from address is code
# (src/lib/email/resend.ts). RESEND_WEBHOOK_SECRET signs the contact.updated
# webhook at /api/email/resend-webhook, from the endpoint's page in the Resend
# dashboard. RESEND_REGISTERED_USERS_SEGMENT_ID is the segment signups join
# (Segments → "Registered Users" — the id in the segment page's URL).
RESEND_API_KEY="replace-with-resend-api-key"
RESEND_WEBHOOK_SECRET="replace-with-resend-webhook-signing-secret"
RESEND_REGISTERED_USERS_SEGMENT_ID="replace-with-resend-segment-id"
# The sending identity, on the Resend-verified domain.
RESEND_FROM_EMAIL="Sender Name <sender@your-verified-domain.com>"
# The sender for list mail — the welcome email and dashboard broadcasts — on a
# Resend-verified subdomain. A mail provider keeps one reputation record per
# signing domain, so bulk sends get their own and the apex above stays the
# address a person writes from. Unset falls back to RESEND_FROM_EMAIL.
RESEND_BULK_FROM_EMAIL="Sender Name <sender@mail.your-verified-domain.com>"
# Where a reply to an outreach note is forwarded so it can be answered from a
# normal inbox, with the user's own address as the reply-to. A bare address —
# it is a recipient, not a sending identity. Unset skips the forward; the row
# is still marked replied. Needs the reply subdomain set up as a Resend
# receiving domain and email.received enabled on the webhook.
RESEND_INBOX_EMAIL="you@your-personal-inbox.com"

# PostHog analytics (client-side project key; public by design, inlined at build).
# Leave unset to disable tracking (e.g. local dev).
NEXT_PUBLIC_POSTHOG_KEY="replace-with-posthog-project-key"

# PostHog query access for the nightly analytics job's HogQL reads: the
# personal API key (query-read scope) and the numeric project id from
# PostHog → Settings → Project. Optional: unset either and the job skips
# PostHog extraction, reporting DB metrics only.
POSTHOG_PERSONAL_API_KEY="replace-with-posthog-personal-api-key"
POSTHOG_PROJECT_ID="replace-with-posthog-numeric-project-id"

# Cloudflare R2 (Cut cloud-mode media storage)
R2_ACCOUNT_ID="replace-with-r2-account-id"
R2_ACCESS_KEY_ID="replace-with-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"

# Cut render worker wake-on-demand. Holding this secret is what turns it on; it
# must match the Worker's CUT_WAKE_SECRET. The address it posts to is code
# (CUT_WORKER_WAKE_URL in src/cut/lib/hosts.ts). Unset in local dev (run the
# worker by hand; it polls on its own).
CUT_RENDER_WAKE_SECRET="replace-with-wake-secret"

# Cloud-media delivery. Required wherever cloud projects are served: every byte
# the browser reads goes through the Cut Worker's R2 binding, addressed by a
# token signed with this. Without it, media reads answer 500. Must match the
# Worker's own CUT_MEDIA_SIGNING_SECRET (openssl rand -hex 32); the hostname is
# code, in src/cut/lib/hosts.ts.
CUT_MEDIA_SIGNING_SECRET="replace-with-media-signing-secret"

# Cut share streaming. Records which HLS ladder version a project publishes, in
# a Workers KV namespace the code creates on first write and then finds by
# title (src/cut/server/cloud/ladderStore.ts) — so this token is the whole
# setup. Needs Workers KV read+write on the account in R2_ACCOUNT_ID. Required
# wherever shares stream: without it a ladder render fails outright and the
# stream route logs and 5xxs, so a misconfiguration is visible rather than
# silent — viewers meanwhile fall back to the project's flattened proxy. The
# render worker holds the same value as a Worker secret, since the container
# writes the pointer when a ladder finishes.
CLOUDFLARE_KV_API_TOKEN="replace-with-kv-api-token"
