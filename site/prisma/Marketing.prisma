// Founder outreach: one row per account per campaign, seeded by the nightly
// outreach-scan job (src/lib/jobs/outreach-scan.ts) and worked by hand from the
// super-user Outreach tab. The row is a marker, not a mailbox — it carries
// status, timestamps, and the scan's credit snapshot, never a subject or a message
// body. The conversation itself lives in the operator's inbox.

model UserOutreach {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Campaign ids live in code (src/lib/marketing/campaigns.ts).
  campaign     String
  // "todo" | "sent" | "replied" | "ignored". The scan creates and retires
  // "todo" rows; every other status is set by a person or by an inbound reply.
  status       String   @default("todo")
  sentCount    Int      @default(0)
  firstSentAt  DateTime?
  lastSentAt   DateTime?
  repliedAt    DateTime?
  ignoredAt    DateTime?
  // The super user whose click sent or filed the row.
  actorUserId  String?
  // The scan's snapshot, so the list renders from this table alone.
  spentMicros  BigInt   @default(0)
  balanceMicros BigInt  @default(0)
  // Cloud media the account was holding when the scan ran.
  storageBytes BigInt   @default(0)
  lastActiveAt DateTime?
  // When the balance last reached zero; null for an account still in credit.
  ranOutAt     DateTime?
  // Why the scan listed the account (ids in src/lib/marketing/campaigns.ts).
  reasons      String[]  @default([])
  // The latest declined Stripe charge inside the payment window.
  paymentFailedAt DateTime?
  scannedAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, campaign])
  @@index([campaign, status, lastActiveAt])
}

// A saved outreach template: the words the operator wrote, kept so the next
// note can start from them. Templates live here rather than in the repo, so
// writing one never needs a deploy. Sending still sends whatever is in the
// dialog at the time — a template is a starting point, not a contract.

model OutreachTemplate {
  id        String   @id @default(cuid())
  // What the send dialog calls it. Unique, so saving under an existing name
  // updates that template instead of leaving two the operator can't tell apart.
  name      String   @unique
  subject   String
  body      String
  // The send toggles the template opens with: the opt-out footer, and routing
  // replies through the signed alias that marks the row replied.
  unsubscribeLink Boolean @default(true)
  trackReplies    Boolean @default(true)
  // The super user who last saved it.
  actorUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A promotion is one email written on su and sent to a segment: an audience
// (the experiment rules, minus country) and, optionally, everyone who already
// received earlier promotions left out. The words live here so a draft can be
// edited, test-sent and counted before anything goes out. Sending resolves the
// segment into recipient rows once and hands them to the promotion-send job.

model Promotion {
  id                  String               @id @default(cuid())
  name                String
  subject             String
  body                String
  ctaLabel            String?
  ctaUrl              String?
  // "bulk" sends from the list address, "personal" from the operator's own.
  sender              String               @default("bulk")
  // Who gets it (src/lib/config/audience via @donkeycut/abexp). {} admits everyone.
  audience            Json                 @default("{}")
  // Earlier promotions whose recipients are skipped.
  excludePromotionIds String[]             @default([])
  // "draft" | "sending" | "sent"
  status              String               @default("draft")
  startedAt           DateTime?
  finishedAt          DateTime?
  actorUserId         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  recipients          PromotionRecipient[]

  @@index([status, createdAt])
}

// One row per account a promotion resolved to. sentAt marks the send; error
// holds why one did not go out. The pair is unique, so a retried send can
// never mail an account twice.
model PromotionRecipient {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt      DateTime?
  // Sends tried so far; the last error stays on the row. A row is given up
  // after MAX_SEND_ATTEMPTS (src/lib/marketing/promotionInput.ts).
  attempts    Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([promotionId, userId])
  @@index([promotionId, sentAt])
}
