<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Donkey is not sandboxed: it runs the bundled Cut engine and the media tools as child processes.
       Under the hardened runtime, TCC denies the microphone without asking unless the signature
       carries audio-input, so screen recordings with a microphone need it. Screen capture is
       governed by TCC and its Info.plist usage string alone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
