    "Allow Donkey in System Settings → Privacy & Security → Accessibility, then apply the size again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Donkey unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen und wende die Größe dann erneut an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Donkey in System Settings → Privacy & Security → Accessibility, then apply the size again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite Donkey en Ajustes del Sistema → Privacidad y seguridad → Accesibilidad, luego vuelve a aplicar el tamaño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Donkey dans Réglages Système → Confidentialité et sécurité → Accessibilité, puis appliquez à nouveau la taille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定 → プライバシーとセキュリティ → アクセシビリティでDonkeyを許可し、もう一度サイズを適用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 Donkey를 허용한 다음, 크기를 다시 적용해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o Donkey em Ajustes do Sistema → Privacidade e Segurança → Acessibilidade e aplique o tamanho novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“系统设置”→“隐私与安全性”→“辅助功能”中允许 Donkey，然后重新应用尺寸。"
          }
        }
      }
    },
    "Allow Microphone access to include your voice." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Mikrofonzugriff, um deine Stimme aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Microphone access to include your voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso al micrófono para incluir tu voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès au micro pour inclure votre voix."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声を含めるには、マイクへのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목소리를 포함하려면 마이크 접근을 허용해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso ao Microfone para incluir sua voz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许访问麦克风以录入你的声音。"
          }
        }
      }
    },
    "Allow Screen Recording in System Settings, then select a window or region." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Bildschirmaufnahme in den Systemeinstellungen und wähle dann ein Fenster oder einen Bereich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Screen Recording in System Settings, then select a window or region."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la Grabación de pantalla en Ajustes del Sistema, luego selecciona una ventana o región."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’enregistrement de l’écran dans les Réglages Système, puis sélectionnez une fenêtre ou une zone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定で画面収録を許可してから、ウインドウまたは領域を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 화면 기록을 허용한 다음, 윈도우 또는 영역을 선택해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita a Gravação de Tela nos Ajustes do Sistema e selecione uma janela ou região."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“系统设置”中允许“屏幕录制”，然后选择窗口或区域。"
          }
        }
      }
    },
