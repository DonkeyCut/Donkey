    "Dimensions include the title bar and use screen points. Retina recordings have more pixels." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maße enthalten die Titelleiste und nutzen Bildschirmpunkte. Retina-Aufnahmen haben mehr Pixel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensions include the title bar and use screen points. Retina recordings have more pixels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las dimensiones incluyen la barra de título y usan puntos de pantalla. Las grabaciones en Retina tienen más píxeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dimensions incluent la barre de titre et utilisent des points d'écran. Les enregistrements Retina ont plus de pixels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寸法にはタイトルバーが含まれ、画面ポイントが使用されます。Retina収録ではピクセル数が多くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기에는 타이틀 바가 포함되며 화면 포인트 단위를 사용해요. Retina 녹화는 픽셀 수가 더 많아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As dimensões incluem a barra de título e usam pontos de tela. Gravações em Retina têm mais pixels."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尺寸包含标题栏并以屏幕点为单位。Retina 录制会有更多像素。"
          }
        }
      }
    },
