    "That clip did not arrive whole." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Clip kam nicht vollständig an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That clip did not arrive whole."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese clip no llegó completo."
