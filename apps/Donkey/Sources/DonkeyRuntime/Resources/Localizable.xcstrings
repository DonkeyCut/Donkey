    "Move the selected window away from overlapping windows, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege das ausgewählte Fenster weg von überlappenden Fenstern und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
