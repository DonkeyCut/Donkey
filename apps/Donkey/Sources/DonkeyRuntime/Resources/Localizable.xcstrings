    "This window cannot be resized. Exit full screen or select a resizable window." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Größe dieses Fensters kann nicht geändert werden. Beende den Vollbildmodus oder wähle ein anpassbares Fenster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This window cannot be resized. Exit full screen or select a resizable window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede cambiar el tamaño de esta ventana. Sal de pantalla completa o selecciona una ventana redimensionable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette fenêtre ne peut pas être redimensionnée. Quittez le mode plein écran ou sélectionnez une fenêtre redimensionnable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウインドウはサイズを変更できません。フルスクリーンを解除するか、サイズ変更可能なウインドウを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 창은 크기를 조절할 수 없어요. 전체 화면을 종료하거나 크기 조절이 가능한 창을 선택해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta janela não pode ser redimensionada. Saia da tela cheia ou selecione uma janela redimensionável."
          }
