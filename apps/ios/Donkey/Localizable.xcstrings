    "Allow photo access in Settings to import from your camera roll." : {
      "comment" : "Here the camera roll and photo library are the iPhone's Photos library; use Apple's own word for it in this language.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube in den Einstellungen den Zugriff auf Fotos, um aus deiner Fotomediathek zu importieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow photo access in Settings to import from your camera roll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a Fotos en Configuración para importar desde tu fototeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l'accès à Photos dans Réglages pour importer depuis votre photothèque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラロールから読み込むには、設定で写真へのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 롤에서 가져오려면 설정에서 사진 접근을 허용해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso às fotos em Ajustes para importar da sua fototeca."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中允许访问照片，以从照片图库导入。"
          }
        }
      }
    },
    "Allow photo access in Settings to save videos." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Foto-Zugriff in den Einstellungen, um Videos zu speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow photo access in Settings to save videos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a Fotos en Configuración para guardar videos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l'accès aux photos dans Réglages pour enregistrer des vidéos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画を保存するには、設定で写真へのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상을 저장하려면 설정에서 사진 접근을 허용해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso às Fotos nos Ajustes para salvar vídeos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中允许访问照片以保存视频。"
          }
        }
      }
    },
