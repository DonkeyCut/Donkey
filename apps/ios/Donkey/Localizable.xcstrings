    "A note holds %lld labels. Take one off to add another." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Notiz fasst %lld Labels. Entferne eins, um ein anderes hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A note holds %lld labels. Take one off to add another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota admite %lld etiquetas. Quita una para agregar otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une note peut contenir %lld étiquettes. Retirez-en une pour en ajouter une autre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノートに付けられるラベルは%lld個までです。追加するには1つ削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모 하나당 라벨을 %lld개까지 추가할 수 있어요. 다른 라벨을 추가하려면 하나를 삭제해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma nota suporta até %lld etiquetas. Remova uma para adicionar outra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每条笔记最多容纳 %lld 个标签。移除一个后方可添加新标签。"
          }
        }
      }
    },
