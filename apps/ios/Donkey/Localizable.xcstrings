    "Both devices need Wi-Fi and Bluetooth on. They do not need to be on a network." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf beiden Geräten müssen WLAN und Bluetooth aktiviert sein. Ein gemeinsames Netzwerk ist nicht erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both devices need Wi-Fi and Bluetooth on. They do not need to be on a network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos dispositivos deben tener Wi-Fi y Bluetooth activados. No necesitan estar en una red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Wi-Fi et le Bluetooth doivent être activés sur les deux appareils. Ils n'ont pas besoin d'être connectés à un réseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方のデバイスでWi-FiとBluetoothをオンにする必要があります。ネットワークに接続している必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 기기 모두 Wi-Fi와 Bluetooth가 켜져 있어야 해요. 네트워크에 연결되어 있을 필요는 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos os dispositivos precisam estar com Wi-Fi e Bluetooth ativados. Não é preciso estar em uma rede."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两台设备均需开启 Wi-Fi 和蓝牙。无需连接到网络。"
          }
        }
      }
    },
